# Vim
*~
*.sw[p_]

# IntelliJ IDEA
*.idea

# Sublime Text
*.sublime-project
*.sublime-workspace

# Ruby Gem
*.gem
.bundle
**/vendor/bundle
# Gemfile.lock is intentionally tracked so CI gets a pre-resolved dependency graph.
# Without it, `bundle install` on Linux may fail to install native gems (sass-embedded, ffi).

# Node.js and NPM
node_modules
npm-debug.log*
package-lock.json
codekit-config.json

# macOS
.DS_Store

# Jekyll generated files
.jekyll-cache
.jekyll-metadata
.sass-cache
_asset_bundler_cache
_site

# Auto-generated by scripts/fetch_readmes.py / GitHub Actions.
# Gitignore it if you rely on Actions to regenerate on each deploy.
# Remove this line to track it so local `jekyll build` works without running the script first.
_data/readmes.yml
